# Copy these entries into your existing .env without deleting other settings.
# Never commit your populated .env or paste tokens into chat.
DERQ_JIRA_BASE_URL=https://company.atlassian.net
DERQ_JIRA_EMAIL=you@company.com
DERQ_JIRA_API_TOKEN=
# Optional starting query. Change it in Connections > Sync & reminders.
DERQ_JIRA_JQL=project = TEAM ORDER BY updated DESC

# Bot token: direct messages and workspace people lookup.
DERQ_SLACK_BOT_TOKEN=
# Authorized Lists token with lists:read and access to the selected List.
# If omitted, the bot token is used; token type support depends on Slack access.
DERQ_SLACK_LISTS_TOKEN=
DERQ_SLACK_LIST_ID=
